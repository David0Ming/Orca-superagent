diff --git a/src/main/runtime/orchestration/managed-delivery.ts b/src/main/runtime/orchestration/managed-delivery.ts
new file mode 100644
index 00000000..57a1daad
--- /dev/null
+++ b/src/main/runtime/orchestration/managed-delivery.ts
@@ -0,0 +1,144 @@
+import type { OrchestrationDb } from './db'
+import { OrchestrationError } from './orchestration-error'
+import { requestManagedOwner } from './managed-owner-client'
+
+const aborts = new WeakMap<OrchestrationDb, Map<string, Set<AbortController>>>()
+const deliveries = new WeakMap<OrchestrationDb, Map<string, Promise<void>>>()
+export const MANAGED_CONTROL_SCHEMA = `
+CREATE TABLE IF NOT EXISTS managed_controls (
+ run_id TEXT PRIMARY KEY, sequence INTEGER NOT NULL DEFAULT 0, stop_pending INTEGER NOT NULL DEFAULT 0,
+ permit_id TEXT, permit_sequence INTEGER);
+CREATE TABLE IF NOT EXISTS managed_deliveries (
+ dispatch_id TEXT PRIMARY KEY, sequence INTEGER NOT NULL, state TEXT NOT NULL, receipt TEXT);
+`
+export function managedControl(db: OrchestrationDb, runId: string) {
+  db.db.prepare('INSERT OR IGNORE INTO managed_controls(run_id) VALUES (?)').run(runId)
+  return db.db.prepare('SELECT * FROM managed_controls WHERE run_id = ?').get(runId)!
+}
+export function revokeManagedPermit(db: OrchestrationDb, runId: string, stopping: boolean): void {
+  managedControl(db, runId)
+  db.db
+    .prepare(
+      'UPDATE managed_controls SET sequence = sequence + 1, permit_id = NULL, stop_pending = CASE WHEN ? THEN sequence + 1 ELSE stop_pending END WHERE run_id = ?'
+    )
+    .run(stopping ? 1 : 0, runId)
+  for (const controller of aborts.get(db)?.get(runId) ?? []) {
+    controller.abort()
+  }
+  if (stopping) {
+    db.db.prepare('UPDATE managed_runs SET closed = 1 WHERE run_id = ?').run(runId)
+  }
+}
+export async function drainManagedDelivery(db: OrchestrationDb, runId: string): Promise<void> {
+  await deliveries.get(db)?.get(runId)
+}
+
+/** Control changes register first, then wait for this transport boundary before claiming effect. */
+export async function deliverManaged<T>(
+  db: OrchestrationDb,
+  runId: string,
+  dispatchId: string,
+  send: (
+    taskSpec?: string,
+    guard?: { signal: AbortSignal; assertCurrent: () => void }
+  ) => Promise<T>
+): Promise<T> {
+  if (!db.db.prepare('SELECT 1 FROM managed_runs WHERE run_id = ?').get(runId)) {
+    return send()
+  }
+  let lanes = deliveries.get(db)
+  if (!lanes) {
+    lanes = new Map()
+    deliveries.set(db, lanes)
+  }
+  const previous = lanes.get(runId)
+  let release!: () => void
+  const active = new Promise<void>((resolve) => {
+    release = resolve
+  })
+  lanes.set(runId, active)
+  await previous
+  const controller = new AbortController()
+  let runs = aborts.get(db)
+  if (!runs) {
+    runs = new Map()
+    aborts.set(db, runs)
+  }
+  const controllers = runs.get(runId) ?? new Set<AbortController>()
+  controllers.add(controller)
+  runs.set(runId, controllers)
+  try {
+    const owner = db.db.prepare('SELECT * FROM managed_runs WHERE run_id = ?').get(runId)!
+    const control = managedControl(db, runId)
+    const intent = db.db
+      .prepare('SELECT id FROM managed_intents WHERE consumed_by = ?')
+      .get(dispatchId)
+    const assertCurrent = () => {
+      controller.signal.throwIfAborted()
+      const current = db.db.prepare('SELECT * FROM managed_runs WHERE run_id = ?').get(runId)
+      const now = managedControl(db, runId)
+      if (
+        !current ||
+        current.closed ||
+        current.dispatch_id !== dispatchId ||
+        current.generation !== owner.generation ||
+        now.stop_pending ||
+        now.sequence !== control.sequence ||
+        now.permit_id !== intent?.id
+      ) {
+        throw new OrchestrationError(
+          'managed_delivery_revoked',
+          'Managed task delivery was revoked before transport acceptance.'
+        )
+      }
+    }
+    assertCurrent()
+    const prior = db.db
+      .prepare('SELECT * FROM managed_deliveries WHERE dispatch_id = ?')
+      .get(dispatchId)
+    if (prior?.state === 'accepted') {
+      return JSON.parse(String(prior.receipt))
+    }
+    if (prior?.state === 'submitting') {
+      throw new OrchestrationError(
+        'operation_unknown',
+        'Managed task delivery may have reached its process; reconcile the original operation before recovery.'
+      )
+    }
+    const admission = await requestManagedOwner(String(owner.endpoint), {
+      id: `deliver:${dispatchId}`,
+      command: ['native', 'activate'],
+      options: {
+        token: String(owner.token),
+        assignment: String(owner.owner),
+        run: runId,
+        intent: String(intent?.id),
+        dispatch: dispatchId,
+        generation: String(owner.generation)
+      }
+    })
+    assertCurrent()
+    if (admission.generation !== owner.generation || !admission.taskSpec) {
+      throw new Error('managed_delivery_requires_current_task_spec')
+    }
+    db.db
+      .prepare("INSERT OR REPLACE INTO managed_deliveries VALUES (?, ?, 'submitting', NULL)")
+      .run(dispatchId, control.sequence)
+    const receipt = await send(admission.taskSpec, { signal: controller.signal, assertCurrent })
+    db.db
+      .prepare(
+        "UPDATE managed_deliveries SET state = 'accepted', receipt = ? WHERE dispatch_id = ?"
+      )
+      .run(JSON.stringify(receipt), dispatchId)
+    return receipt
+  } finally {
+    controllers.delete(controller)
+    if (!controllers.size) {
+      runs.delete(runId)
+    }
+    release()
+    if (lanes.get(runId) === active) {
+      lanes.delete(runId)
+    }
+  }
+}
diff --git a/src/main/runtime/orchestration/managed-owner-client.ts b/src/main/runtime/orchestration/managed-owner-client.ts
new file mode 100644
index 00000000..4c3d36e0
--- /dev/null
+++ b/src/main/runtime/orchestration/managed-owner-client.ts
@@ -0,0 +1,56 @@
+import { connect } from 'node:net'
+
+export function requestManagedOwner(
+  endpoint: string,
+  request: object
+): Promise<{ generation: number; taskSpec?: string }> {
+  return new Promise((resolve, reject) => {
+    const socket = connect(endpoint)
+    let data = ''
+    socket.setEncoding('utf8')
+    socket.setTimeout(45000, () => socket.destroy(new Error('managed_owner_unavailable')))
+    socket.on('error', reject)
+    socket.on('connect', () => socket.write(`${JSON.stringify(request)}\n`))
+    socket.on('data', (chunk) => {
+      data += chunk
+      if (data.length > 64000) {
+        socket.destroy(new Error('managed_owner_reply_too_large'))
+        return
+      }
+      if (!data.includes('\n')) {
+        return
+      }
+      socket.end()
+      try {
+        const answer: unknown = JSON.parse(data.slice(0, data.indexOf('\n')))
+        if (
+          !answer ||
+          typeof answer !== 'object' ||
+          !('ok' in answer) ||
+          answer.ok !== true ||
+          !('result' in answer) ||
+          !answer.result ||
+          typeof answer.result !== 'object' ||
+          !('generation' in answer.result) ||
+          typeof answer.result.generation !== 'number' ||
+          (!Number.isSafeInteger(answer.result.generation) || answer.result.generation < 1)
+        ) {
+          throw new Error('managed_fence_refused')
+        }
+        resolve({
+          generation: answer.result.generation,
+          ...('taskSpec' in answer.result && typeof answer.result.taskSpec === 'string'
+            ? { taskSpec: answer.result.taskSpec }
+            : {})
+        })
+      } catch (error) {
+        reject(error)
+      }
+    })
+    socket.on('end', () => {
+      if (!data.includes('\n')) {
+        reject(new Error('managed_owner_reply_missing'))
+      }
+    })
+  })
+}
diff --git a/src/main/runtime/orchestration/managed-run.test.ts b/src/main/runtime/orchestration/managed-run.test.ts
new file mode 100644
index 00000000..cdfc2b08
--- /dev/null
+++ b/src/main/runtime/orchestration/managed-run.test.ts
@@ -0,0 +1,368 @@
+import { dedupeWorkerStop } from '../rpc/methods/orchestration/worker/worker-stop-flight'
+import type { OrcaRuntimeService } from '../orca-runtime'
+import { deliverManaged, revokeManagedPermit, drainManagedDelivery } from './managed-delivery'
+import { createServer, type Server } from 'node:net'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, test } from 'vitest'
+import { OrchestrationDb } from './db'
+import {
+  registerManagedRun,
+  fenceManagedRun,
+  assertManagedStop,
+  admitManagedProcess
+} from './managed-run'
+
+const cleanups: (() => Promise<void> | void)[] = []
+afterEach(async () => {
+  for (const close of cleanups.splice(0).toReversed()) {
+    await close()
+  }
+})
+async function fixture(beforeReply?: (request: { command?: string[] }) => Promise<void>) {
+  const dir = mkdtempSync(join(tmpdir(), 'orca-managed-'))
+  cleanups.push(() => rmSync(dir, { recursive: true, force: true }))
+  let db = new OrchestrationDb(join(dir, 'db'))
+  cleanups.push(() => db.close())
+  const endpoint = join(dir, 'owner.sock')
+  let generation = 0
+  const replies = new Map<string, number>()
+  const requests: { id: string; options: { action: string } }[] = []
+  let server: Server | undefined = createServer((socket) => {
+    let data = ''
+    socket.on('data', async (chunk) => {
+      data += chunk.toString()
+      if (!data.includes('\n')) {
+        return
+      }
+      const request = JSON.parse(data)
+      requests.push(request)
+      await beforeReply?.(request)
+      if (!replies.has(request.id)) {
+        replies.set(
+          request.id,
+          request.command?.[1] === 'activate' ? Number(request.options.generation) : ++generation
+        )
+      }
+      socket.end(
+        `${JSON.stringify({ ok: true, result: { generation: replies.get(request.id), taskSpec: 'current owner scope' } })}\n`
+      )
+    })
+  })
+  await new Promise<void>((resolve) => server!.listen(endpoint, resolve))
+  const closeServer = async () => {
+    if (server) {
+      await new Promise<void>((resolve, reject) =>
+        server!.close((error) => (error ? reject(error) : resolve()))
+      )
+    }
+    server = undefined
+  }
+  cleanups.push(closeServer)
+  const runId = db.createRun({
+    objective: 'managed test',
+    coordinatorHandle: null,
+    coordinatorPaneKey: null
+  }).id
+  const owner = {
+    runId,
+    owner: 'osa',
+    token: 's'.repeat(32),
+    endpoint,
+    action: 'register' as const
+  }
+  const task = db.createTask({ runId, spec: 'managed work' })
+  registerManagedRun(db, owner)
+  const start = (managedIntent?: string, retryOf?: string) =>
+    db.createStartingWorkerDispatch({
+      creator: { kind: 'system' },
+      maxDepth: 10,
+      taskId: task.id,
+      startOptions: {},
+      managedIntent,
+      retryOf
+    }).dispatch
+  return {
+    get db() {
+      return db
+    },
+    task,
+    runId,
+    owner,
+    start,
+    requests,
+    closeServer,
+    restart() {
+      db.close()
+      db = new OrchestrationDb(join(dir, 'db'))
+    }
+  }
+}
+
+test('managed starts fail closed across restart and same Task retries retain the native circuit breaker', async () => {
+  const f = await fixture()
+  expect(() => f.start()).toThrow('requires_current_fence')
+  let previous: string | undefined
+  for (let n = 1; n <= 3; n++) {
+    const intent = await fenceManagedRun(f.db, f.runId, 'start', previous)
+    const dispatch = f.start(intent, previous)
+    expect(dispatch.task_id).toBe(f.task.id)
+    expect(registerManagedRun(f.db, { ...f.owner, action: 'status' })).toMatchObject({
+      generation: n,
+      dispatch_id: dispatch.id,
+      closed: 0
+    })
+    expect(() => f.start(intent, previous)).toThrow()
+    f.db.failWorkerStart(dispatch.id, 'agent_readiness', 'test startup failure')
+    previous = dispatch.id
+    f.restart()
+    expect(() => f.start(undefined, previous)).toThrow()
+  }
+  expect(f.db.getDispatchContextById(previous!)).toMatchObject({
+    failure_count: 3,
+    status: 'circuit_broken'
+  })
+  const intent = await fenceManagedRun(f.db, f.runId, 'start', previous)
+  expect(() => f.start(intent, previous)).toThrow('will not retry it again')
+  expect(f.db.db.prepare('SELECT COUNT(*) AS count FROM managed_dispatches').get()).toMatchObject({
+    count: 3
+  })
+})
+
+test('owner offline refuses startup; stop invalidates an unconsumed start grant', async () => {
+  const f = await fixture()
+  const intent = await fenceManagedRun(f.db, f.runId, 'start')
+  // A stop arriving after a start grant must invalidate it before any child is launched.
+  await fenceManagedRun(f.db, f.runId, 'stop')
+  expect(() => f.start(intent)).toThrow('requires_current_fence')
+  await f.closeServer()
+  await expect(fenceManagedRun(f.db, f.runId, 'start', 'wrong')).rejects.toThrow('predecessor')
+  // A second registered Run has no cached callback response to reuse.
+  f.db.db.prepare('DELETE FROM managed_intents').run()
+  await expect(fenceManagedRun(f.db, f.runId, 'start')).rejects.toThrow()
+  expect(() => f.start()).toThrow('requires_current_fence')
+})
+
+test('the persistent database fence protects direct Dispatch inserts and stop requires prior closure', async () => {
+  const f = await fixture()
+  const first = f.start(await fenceManagedRun(f.db, f.runId, 'start'))
+  expect(() => assertManagedStop(f.db.db, f.runId, first.id)).toThrow('requires_fence')
+  await fenceManagedRun(f.db, f.runId, 'stop', first.id)
+  expect(() => assertManagedStop(f.db.db, f.runId, first.id)).not.toThrow()
+  f.restart()
+  expect(() =>
+    f.db.db
+      .prepare('INSERT INTO dispatch_contexts(id, run_id) VALUES (?, ?)')
+      .run('bypass', f.runId)
+  ).toThrow('managed_dispatch_requires_fence')
+  expect(registerManagedRun(f.db, { ...f.owner, action: 'status' })).toMatchObject({ closed: 1 })
+})
+
+test('adoption preserves a single existing Task, closes its old authority, and never resets retry failures', async () => {
+  const f = await fixture()
+  const run = f.db.createRun({
+    objective: 'legacy OSA assignment',
+    coordinatorHandle: null,
+    coordinatorPaneKey: null
+  })
+  const task = f.db.createTask({ runId: run.id, spec: 'existing work' })
+  const old = f.db.createStartingWorkerDispatch({
+    creator: { kind: 'system' },
+    maxDepth: 10,
+    taskId: task.id,
+    startOptions: {}
+  }).dispatch
+  f.db.failWorkerStart(old.id, 'agent_readiness', 'pre-upgrade failure')
+  expect(() => registerManagedRun(f.db, { ...f.owner, runId: run.id })).toThrow('empty_run')
+  expect(() =>
+    registerManagedRun(f.db, { ...f.owner, runId: run.id, action: 'adopt', dispatchId: 'wrong' })
+  ).toThrow('identity_mismatch')
+  expect(
+    registerManagedRun(f.db, { ...f.owner, runId: run.id, action: 'adopt', dispatchId: old.id })
+  ).toMatchObject({ closed: 1, generation: 0, dispatch_id: old.id })
+  f.restart()
+  const managedIntent = await fenceManagedRun(f.db, run.id, 'start', old.id)
+  const next = f.db.createStartingWorkerDispatch({
+    creator: { kind: 'system' },
+    maxDepth: 10,
+    taskId: task.id,
+    startOptions: {},
+    retryOf: old.id,
+    managedIntent
+  }).dispatch
+  expect(next).toMatchObject({ task_id: task.id, failure_count: 1 })
+})
+
+test('REVIEW: stale managed start grant must recheck owner admission before reuse', async () => {
+  const f = await fixture()
+  const first = await fenceManagedRun(f.db, f.runId, 'start')
+  expect(f.requests).toHaveLength(1)
+  const second = await fenceManagedRun(f.db, f.runId, 'start')
+  expect(second).toBe(first)
+  expect(f.requests).toHaveLength(2)
+})
+
+test('REVIEW: managed session restart after failed dispatch cannot bypass fence', async () => {
+  const f = await fixture()
+  const dispatch = f.start(await fenceManagedRun(f.db, f.runId, 'start'))
+  const pane = 'tab_1:11111111-1111-4111-8111-111111111111'
+  f.db.prepareStartingWorkerAuthority({
+    dispatchId: dispatch.id,
+    handle: 'term_worker',
+    paneKey: pane,
+    processIncarnation: 'runtime:worker:1',
+    worktreeId: 'repo::same',
+    effects: [],
+    setupState: 'not_applicable'
+  })
+  await admitManagedProcess(f.db, 'term_worker', 'session-worker', 'first-token')
+  f.db.failWorkerStart(dispatch.id, 'agent_readiness', 'failed')
+  await expect(
+    admitManagedProcess(f.db, 'term_worker', 'session-worker', 'second-token')
+  ).rejects.toThrow()
+  await expect(admitManagedProcess(f.db, '', 'session-worker', 'third-token')).rejects.toThrow()
+})
+
+test('REVIEW CONTROL: active managed session accepts matching pin and fences changed token', async () => {
+  const f = await fixture(),
+    dispatch = f.start(await fenceManagedRun(f.db, f.runId, 'start'))
+  f.db.prepareStartingWorkerAuthority({
+    dispatchId: dispatch.id,
+    handle: 'term_worker',
+    paneKey: 'tab_1:11111111-1111-4111-8111-111111111111',
+    processIncarnation: 'runtime:worker:1',
+    worktreeId: 'repo::same',
+    effects: [],
+    setupState: 'not_applicable'
+  })
+  await admitManagedProcess(f.db, 'term_worker', 'session-worker', 'first-token')
+  await admitManagedProcess(f.db, 'term_worker', 'session-worker', 'first-token')
+  await expect(
+    admitManagedProcess(f.db, 'term_worker', 'session-worker', 'second-token')
+  ).rejects.toThrow('managed_process_restart_requires_task_retry')
+  expect(f.requests.at(-1)?.options.action).toBe('restart')
+})
+
+test('revocation during owner admission prevents an unconsumed start from creating a Dispatch', async () => {
+  let reached!: () => void, release!: () => void
+  const arrived = new Promise<void>((resolve) => {
+    reached = resolve
+  })
+  const hold = new Promise<void>((resolve) => {
+    release = resolve
+  })
+  const f = await fixture(async () => {
+    reached()
+    await hold
+  })
+  const pending = fenceManagedRun(f.db, f.runId, 'start')
+  await Promise.race([
+    arrived,
+    pending.then(() => {
+      throw new Error('transport was never entered')
+    })
+  ])
+  revokeManagedPermit(f.db, f.runId, false)
+  release()
+  await expect(pending).rejects.toThrow('control changed')
+  expect(() => f.start()).toThrow('requires_current_fence')
+})
+
+test('a control change between Dispatch creation and task delivery prevents the old task transport', async () => {
+  const f = await fixture(),
+    dispatch = f.start(await fenceManagedRun(f.db, f.runId, 'start'))
+  revokeManagedPermit(f.db, f.runId, false)
+  let sent = false
+  await expect(
+    deliverManaged(f.db, f.runId, dispatch.id, async () => {
+      sent = true
+    })
+  ).rejects.toThrow('revoked')
+  expect(sent).toBe(false)
+})
+
+test('a control change waits for already-entered transport and revokes subsequent deliveries', async () => {
+  const f = await fixture(),
+    dispatch = f.start(await fenceManagedRun(f.db, f.runId, 'start'))
+  let reached!: () => void, release!: () => void
+  const arrived = new Promise<void>((resolve) => {
+      reached = resolve
+    }),
+    hold = new Promise<void>((resolve) => {
+      release = resolve
+    })
+  const delivery = deliverManaged(f.db, f.runId, dispatch.id, async (spec) => {
+    expect(spec).toBe('current owner scope')
+    reached()
+    await hold
+    return { accepted: true }
+  })
+  await Promise.race([
+    arrived,
+    delivery.then(() => {
+      throw new Error('transport was never entered')
+    })
+  ])
+  revokeManagedPermit(f.db, f.runId, false)
+  let changed = false
+  const mutation = drainManagedDelivery(f.db, f.runId).then(() => {
+    changed = true
+  })
+  expect(changed).toBe(false)
+  release()
+  await delivery
+  await mutation
+  expect(changed).toBe(true)
+  await expect(
+    deliverManaged(f.db, f.runId, dispatch.id, async () => ({ accepted: true }))
+  ).rejects.toThrow('revoked')
+})
+
+test('revocation while transport waits aborts the actual acceptance boundary', async () => {
+  const f = await fixture(),
+    dispatch = f.start(await fenceManagedRun(f.db, f.runId, 'start'))
+  let arrived!: () => void, release!: () => void
+  const reached = new Promise<void>((resolve) => {
+    arrived = resolve
+  })
+  const hold = new Promise<void>((resolve) => {
+    release = resolve
+  })
+  let accepted = false
+  const delivery = deliverManaged(f.db, f.runId, dispatch.id, async (_spec, guard) => {
+    arrived()
+    await hold
+    guard!.assertCurrent()
+    accepted = true
+    return { accepted: true }
+  })
+  const rejected = expect(delivery).rejects.toThrow()
+  await reached
+  revokeManagedPermit(f.db, f.runId, true)
+  release()
+  await rejected
+  expect(accepted).toBe(false)
+})
+
+test('native stop closes the physical process even when its managed owner is offline', async () => {
+  const f = await fixture(),
+    dispatch = f.start(await fenceManagedRun(f.db, f.runId, 'start'))
+  await f.closeServer()
+  let physicallyStopped = false
+  const runtime = { getOrchestrationDb: () => f.db } as OrcaRuntimeService
+  await dedupeWorkerStop(runtime, dispatch.id, async () => {
+    assertManagedStop(f.db.db, f.runId, dispatch.id)
+    physicallyStopped = true
+    return { state: 'stopped' }
+  })
+  expect(physicallyStopped).toBe(true)
+  expect(registerManagedRun(f.db, { ...f.owner, action: 'status' })).toMatchObject({
+    closed: 1,
+    stopPending: 1
+  })
+  f.restart()
+  await expect(fenceManagedRun(f.db, f.runId, 'start', dispatch.id)).rejects.toThrow(
+    'stop remains pending'
+  )
+})
diff --git a/src/main/runtime/orchestration/managed-run.ts b/src/main/runtime/orchestration/managed-run.ts
