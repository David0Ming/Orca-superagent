@@ -0,0 +1,137 @@
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it } from 'vitest'
+import { JournalHostDatabase } from './journal-host-database'
+import { captureJournalInputs, useInputStream } from './journal-input-stream'
+import { runWithActiveRpcCaller } from '../../runtime/rpc/rpc-active-caller'
+import { JournalRowWriter } from './journal-row-writer'
+import { JournalWriteQueue } from './journal-write-queue'
+import type { JournalRow } from './journal-row-schema'
+
+const cleanups: (() => Promise<void>)[] = []
+afterEach(async () => {
+  for (const cleanup of cleanups.splice(0)) {
+    await cleanup()
+  }
+})
+function setup() {
+  const directory = mkdtempSync(join(tmpdir(), 'orca-input-stream-'))
+  let host = JournalHostDatabase.open(directory)
+  cleanups.push(async () => {
+    await host.close()
+    rmSync(directory, { recursive: true, force: true })
+  })
+  const input = { sessionId: 'chat', consumer: 'consumer-secret-with-more-than-32-chars' }
+  const registered = host.transaction((db) => useInputStream(db, { ...input, action: 'register' }))
+  const streamId = String(registered.streamId)
+  const call = (action: 'read' | 'ack' | 'barrier', cursor?: number) =>
+    host.transaction((db) => useInputStream(db, { ...input, streamId, action, cursor }))
+  return {
+    input,
+    streamId,
+    call,
+    get host() {
+      return host
+    },
+    async restart() {
+      await host.close()
+      host = JournalHostDatabase.open(directory)
+    }
+  }
+}
+function row(seq: number): JournalRow {
+  return {
+    kind: 'submission',
+    v: 1,
+    epoch: 'render-epoch',
+    seq,
+    ts: 1,
+    fence: 0,
+    clientMessageId: `message-${seq}`,
+    payloadFingerprint: 'hash',
+    providerHandle: { kind: 'codex', threadId: 'provider' },
+    origin: 'client',
+    source: { kind: 'user' },
+    body: { kind: 'message', role: 'user', blocks: [{ type: 'text', text: 'do the work' }] }
+  }
+}
+it('retains ordered inputs across render deletion and restart, while CLI user role is automation', async () => {
+  const f = setup()
+  runWithActiveRpcCaller({ kind: 'desktop' }, () =>
+    f.host.transaction((db) => captureJournalInputs(db, 'chat', [row(1)]))
+  )
+  runWithActiveRpcCaller({ kind: 'local-cli' }, () =>
+    f.host.transaction((db) => captureJournalInputs(db, 'chat', [row(2)]))
+  )
+  f.host.transaction((db) =>
+    db.prepare('DELETE FROM journal_rows WHERE session_id = ?').run('chat')
+  )
+  await f.restart()
+  const page = f.call('read', 0)
+  expect('events' in page && page.events?.map((event) => event.source)).toEqual([
+    'human',
+    'automation'
+  ])
+  expect(page.cursor).toBe(2)
+  f.call('ack', 2)
+  expect(() => f.call('read', 0)).toThrow('gap')
+  expect('events' in f.call('read', 2)).toBe(true)
+})
+it('commits event and submission together, with barriers on the same write lane', async () => {
+  const f = setup(),
+    queue = new JournalWriteQueue('chat')
+  let next = 1
+  const writer = new JournalRowWriter({
+    sessionId: 'chat',
+    now: () => 1,
+    serialize: (run) => queue.serialize(run),
+    database: () => f.host,
+    readOnly: () => false,
+    highestFence: () => 0,
+    nextSequence: () => next,
+    commit: (rows) => {
+      next += rows.length
+    }
+  })
+  await expect(
+    writer.enqueue(() => row(1), {
+      write: () => {
+        throw new Error('injected crash')
+      },
+      committed: () => {}
+    })
+  ).rejects.toThrow('injected crash')
+  expect(f.call('read', 0).cursor).toBe(0)
+  await runWithActiveRpcCaller({ kind: 'paired-device', deviceId: 'phone' }, () =>
+    writer.enqueue(() => row(1))
+  )
+  const barrier = await queue.readInOrder(() => f.call('barrier'))
+  await writer.enqueue(() => row(2))
+  expect(barrier.cursor).toBe(2)
+  const origins = f.call('read', 0)
+  expect('events' in origins && origins.events?.[0].source).toBe('unknown')
+  const page = f.call('read', 0)
+  expect('events' in page && page.events?.map((event) => event.kind)).toEqual([
+    'submission',
+    'barrier',
+    'submission'
+  ])
+})
+it('refuses ack before delivery, a different consumer and full retention without dropping input', () => {
+  const f = setup()
+  f.host.transaction((db) => captureJournalInputs(db, 'chat', [row(1)]))
+  expect(() => f.call('ack', 1)).toThrow('ahead_of_delivery')
+  expect(() =>
+    f.host.transaction((db) =>
+      useInputStream(db, { ...f.input, consumer: 'wrong', action: 'register' })
+    )
+  ).toThrow('consumer_mismatch')
+  f.host.db
+    .prepare('UPDATE journal_input_streams SET head = 10000 WHERE session_id = ?')
+    .run('chat')
+  expect(() => f.host.transaction((db) => captureJournalInputs(db, 'chat', [row(2)]))).toThrow(
+    'input_stream_full'
+  )
+  expect(f.host.db.prepare('SELECT COUNT(*) AS n FROM journal_input_events').get()?.n).toBe(1)
+})
diff --git a/src/main/native-chat/agent-session-journal/journal-input-stream.ts b/src/main/native-chat/agent-session-journal/journal-input-stream.ts
new file mode 100644
index 00000000..5e4cd561
--- /dev/null
+++ b/src/main/native-chat/agent-session-journal/journal-input-stream.ts
@@ -0,0 +1,154 @@
+import { createHash, randomUUID } from 'node:crypto'
+import type { z } from 'zod'
+import type Database from '../../sqlite/sync-database'
+import { getActiveRpcCaller } from '../../runtime/rpc/rpc-active-caller'
+import type { JournalRow } from './journal-row-schema'
+
+import type { InputStreamRequest } from '../../../shared/rpc-contract/agent-session-input-stream-params'
+
+export function createInputStreamTables(db: Database.Database): void {
+  db.exec(`CREATE TABLE IF NOT EXISTS journal_input_streams (
+    session_id TEXT PRIMARY KEY, id TEXT NOT NULL, consumer_hash TEXT NOT NULL,
+    head INTEGER NOT NULL DEFAULT 0, ack INTEGER NOT NULL DEFAULT 0,
+    delivered INTEGER NOT NULL DEFAULT 0, started_at INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS journal_input_events (
+    session_id TEXT NOT NULL, sequence INTEGER NOT NULL, event_json TEXT NOT NULL,
+    PRIMARY KEY(session_id, sequence));`)
+}
+
+/** Retain accepted input independently of render epochs, in the submission's FULL transaction. */
+export function captureJournalInputs(
+  db: Database.Database,
+  sessionId: string,
+  rows: readonly JournalRow[]
+): void {
+  if (!db.prepare('SELECT 1 FROM journal_input_streams WHERE session_id = ?').get(sessionId)) {
+    return
+  }
+  const caller = getActiveRpcCaller()
+  const source =
+    caller?.kind === 'desktop' ? 'human' : caller?.kind === 'local-cli' ? 'automation' : 'unknown'
+  for (const row of rows) {
+    if (row.kind === 'submission') {
+      appendInputEvent(db, sessionId, {
+        kind: 'submission',
+        messageId: row.queuedMessageId ?? row.clientMessageId,
+        source:
+          row.origin === 'client' && row.source?.kind === 'user' && !row.body.from
+            ? source
+            : 'automation',
+        body: row.body,
+        at: row.ts
+      })
+    } else if (row.kind === 'queue' && ['queued', 'edited', 'withdrawn'].includes(row.change.op)) {
+      appendInputEvent(db, sessionId, {
+        kind: row.change.op,
+        messageId: row.messageId,
+        source: 'body' in row.change && row.change.body.from ? 'automation' : source,
+        change: row.change,
+        at: row.ts
+      })
+    } else if (row.kind === 'tombstone' && row.stopEvent) {
+      appendInputEvent(db, sessionId, { kind: 'stop', source, stop: row.stopEvent, at: row.ts })
+    }
+  }
+}
+
+function appendInputEvent(db: Database.Database, sessionId: string, event: object): number {
+  const stream = db
+    .prepare('SELECT id, head, ack FROM journal_input_streams WHERE session_id = ?')
+    .get(sessionId)
+  if (!stream) {
+    throw new Error('input_stream_not_registered')
+  }
+  // shortcut: retention is capped at 10,000 rows; use a transactional byte counter if that bound grows.
+  const bytes = db
+    .prepare(
+      'SELECT COALESCE(SUM(length(CAST(event_json AS BLOB))), 0) AS bytes FROM journal_input_events WHERE session_id = ?'
+    )
+    .get(sessionId)
+  const sequence = Number(stream.head) + 1
+  const body = JSON.stringify({ ...event, id: `${stream.id}:${sequence}`, sequence })
+  if (
+    Number(stream.head) - Number(stream.ack) >= 10000 ||
+    Number(bytes?.bytes) + Buffer.byteLength(body) > 32 * 1024 * 1024
+  ) {
+    throw new Error(
+      'input_stream_full: consumer must acknowledge retained input before another submission'
+    )
+  }
+  db.prepare('INSERT INTO journal_input_events VALUES (?, ?, ?)').run(sessionId, sequence, body)
+  db.prepare('UPDATE journal_input_streams SET head = ? WHERE session_id = ?').run(
+    sequence,
+    sessionId
+  )
+  return sequence
+}
+
+/** Called on the journal write lane in a FULL host database transaction. */
+export function useInputStream(db: Database.Database, input: z.infer<typeof InputStreamRequest>) {
+  const { sessionId, action } = input
+  const hash = createHash('sha256').update(input.consumer).digest('hex')
+  let stream = db.prepare('SELECT * FROM journal_input_streams WHERE session_id = ?').get(sessionId)
+  if (!stream && action === 'register') {
+    db.prepare(
+      'INSERT INTO journal_input_streams(session_id, id, consumer_hash, started_at) VALUES (?, ?, ?, ?)'
+    ).run(sessionId, randomUUID(), hash, Date.now())
+    stream = db.prepare('SELECT * FROM journal_input_streams WHERE session_id = ?').get(sessionId)
+  }
+  if (!stream || stream.consumer_hash !== hash) {
+    throw new Error('input_stream_consumer_mismatch')
+  }
+  if (action !== 'register' && input.streamId !== stream.id) {
+    throw new Error('input_stream_gap: stream identity changed')
+  }
+  if (action === 'barrier') {
+    const cursor = appendInputEvent(db, sessionId, { kind: 'barrier', at: Date.now() })
+    return { streamId: stream.id, cursor }
+  }
+  const cursor = input.cursor ?? Number(stream.ack)
+  if (cursor < Number(stream.ack) || cursor > Number(stream.head)) {
+    throw new Error('input_stream_gap: cursor outside retained interval')
+  }
+  if (action === 'ack') {
+    if (cursor > Number(stream.delivered)) {
+      throw new Error('input_stream_ack_ahead_of_delivery')
+    }
+    db.prepare('UPDATE journal_input_streams SET ack = ? WHERE session_id = ?').run(
+      cursor,
+      sessionId
+    )
+    db.prepare('DELETE FROM journal_input_events WHERE session_id = ? AND sequence <= ?').run(
+      sessionId,
+      cursor
+    )
+  }
+  const events =
+    action === 'read'
+      ? db
+          .prepare(
+            'SELECT sequence, event_json FROM journal_input_events WHERE session_id = ? AND sequence > ? ORDER BY sequence LIMIT 100'
+          )
+          .all(sessionId, cursor)
+      : []
+  const end = events.length ? Number(events.at(-1)?.sequence) : cursor
+  if (action === 'read') {
+    if (
+      (events.length && Number(events[0].sequence) !== cursor + 1) ||
+      (!events.length && cursor !== Number(stream.head))
+    ) {
+      throw new Error('input_stream_gap: retained event missing')
+    }
+    db.prepare(
+      'UPDATE journal_input_streams SET delivered = MAX(delivered, ?) WHERE session_id = ?'
+    ).run(end, sessionId)
+  }
+  return {
+    streamId: stream.id,
+    startedAt: stream.started_at,
+    cursor: end,
+    head: stream.head,
+    acknowledged: action === 'ack' ? cursor : stream.ack,
+    events: events.map((row) => JSON.parse(String(row.event_json)))
+  }
+}
