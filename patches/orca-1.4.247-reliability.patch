index 00000000..9b009114
--- /dev/null
+++ b/src/main/runtime/orchestration/managed-run.ts
@@ -0,0 +1,292 @@
+import {
+  MANAGED_CONTROL_SCHEMA,
+  managedControl,
+  revokeManagedPermit,
+  drainManagedDelivery
+} from './managed-delivery'
+import { requestManagedOwner } from './managed-owner-client'
+import { createHash } from 'node:crypto'
+import { isAbsolute } from 'node:path'
+import { OrchestrationError } from './orchestration-error'
+import type Database from '../../sqlite/sync-database'
+import type { OrchestrationDb } from './db'
+
+export const MANAGED_RUN_SCHEMA = `${MANAGED_CONTROL_SCHEMA}
+CREATE TABLE IF NOT EXISTS managed_runs (
+  run_id TEXT PRIMARY KEY, owner TEXT NOT NULL, token TEXT NOT NULL, endpoint TEXT NOT NULL,
+  generation INTEGER NOT NULL DEFAULT 0, dispatch_id TEXT, closed INTEGER NOT NULL DEFAULT 1);
+CREATE TABLE IF NOT EXISTS managed_intents (
+  id TEXT PRIMARY KEY, run_id TEXT NOT NULL, action TEXT NOT NULL, previous TEXT,
+  generation INTEGER, consumed_by TEXT);
+CREATE TABLE IF NOT EXISTS managed_dispatches (
+  dispatch_id TEXT PRIMARY KEY, run_id TEXT NOT NULL, generation INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS managed_processes (
+  dispatch_id TEXT PRIMARY KEY, session_id TEXT NOT NULL, proof_hash TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS managed_reports (
+  id TEXT PRIMARY KEY, dispatch_id TEXT NOT NULL, run_id TEXT NOT NULL, sequence INTEGER NOT NULL,
+  hash TEXT NOT NULL, credential_hash TEXT NOT NULL, request_json TEXT NOT NULL, proof_json TEXT NOT NULL, message_id TEXT,
+  UNIQUE(dispatch_id, sequence));
+CREATE TRIGGER IF NOT EXISTS managed_dispatch_admission BEFORE INSERT ON dispatch_contexts
+WHEN EXISTS(SELECT 1 FROM managed_runs WHERE run_id = NEW.run_id)
+AND NOT EXISTS(SELECT 1 FROM managed_dispatches WHERE dispatch_id = NEW.id AND run_id = NEW.run_id)
+BEGIN SELECT RAISE(ABORT, 'managed_dispatch_requires_fence'); END;
+`
+
+export function registerManagedRun(
+  db: OrchestrationDb,
+  input: {
+    runId: string
+    owner: string
+    token: string
+    endpoint: string
+    action: 'register' | 'status' | 'adopt'
+    dispatchId?: string
+  }
+) {
+  const existing = db.db.prepare('SELECT * FROM managed_runs WHERE run_id = ?').get(input.runId)
+  if (!existing) {
+    const run = db.getRun(input.runId)
+    if (input.action === 'status' || !run) {
+      throw new Error('managed_run_missing')
+    }
+    if (run.legacy) {
+      throw new Error('managed_run_requires_explicit_run')
+    }
+    if (
+      (!isAbsolute(input.endpoint) && !input.endpoint.startsWith('\\\\.\\pipe\\')) ||
+      input.endpoint.includes('\n')
+    ) {
+      throw new Error('managed_endpoint_invalid')
+    }
+    const latest = db.db
+      .prepare('SELECT id FROM dispatch_contexts WHERE run_id = ? ORDER BY rowid DESC LIMIT 1')
+      .get(input.runId)
+    if (input.action === 'adopt') {
+      if (
+        !latest ||
+        latest.id !== input.dispatchId ||
+        Number(
+          db.db
+            .prepare('SELECT COUNT(DISTINCT task_id) AS n FROM dispatch_contexts WHERE run_id = ?')
+            .get(input.runId)?.n
+        ) !== 1
+      ) {
+        throw new Error('managed_adoption_identity_mismatch')
+      }
+    } else if (latest) {
+      throw new Error('managed_run_requires_empty_run')
+    }
+    db.db.pragma('synchronous = FULL')
+    db.db
+      .prepare(
+        'INSERT INTO managed_runs(run_id, owner, token, endpoint, dispatch_id) VALUES (?, ?, ?, ?, ?)'
+      )
+      .run(
+        input.runId,
+        input.owner,
+        input.token,
+        input.endpoint,
+        input.action === 'adopt' ? input.dispatchId! : null
+      )
+  } else if (
+    existing.owner !== input.owner ||
+    existing.token !== input.token ||
+    existing.endpoint !== input.endpoint
+  ) {
+    throw new Error('managed_owner_mismatch')
+  }
+  const current = db.db
+    .prepare('SELECT generation, dispatch_id, closed FROM managed_runs WHERE run_id = ?')
+    .get(input.runId)
+  return {
+    runId: input.runId,
+    ...current,
+    stopPending: managedControl(db, input.runId).stop_pending
+  }
+}
+
+export async function fenceManagedRun(
+  db: OrchestrationDb,
+  runId: string,
+  action: 'start' | 'stop' | 'restart',
+  previous?: string
+): Promise<string | undefined> {
+  const owner = db.db.prepare('SELECT * FROM managed_runs WHERE run_id = ?').get(runId)
+  if (!owner) {
+    return undefined
+  }
+  if (action === 'stop' && (owner.dispatch_id ?? undefined) !== previous) {
+    return undefined
+  }
+  if ((owner.dispatch_id ?? undefined) !== previous) {
+    throw new Error('managed_predecessor_changed')
+  }
+  if (action !== 'start') {
+    revokeManagedPermit(db, runId, true)
+  }
+  const control = managedControl(db, runId)
+  if (action === 'start' && control.stop_pending) {
+    throw new OrchestrationError('managed_admission_refused', 'Managed stop remains pending.')
+  }
+  const finishStop = async () => {
+    await drainManagedDelivery(db, runId)
+    db.db
+      .prepare('UPDATE managed_controls SET stop_pending = 0 WHERE run_id = ? AND stop_pending = ?')
+      .run(runId, control.stop_pending)
+  }
+  const granted = db.db
+    .prepare(
+      'SELECT id FROM managed_intents WHERE run_id = ? AND action = ? AND previous IS ? AND generation = ? AND consumed_by IS NULL'
+    )
+    .get(runId, action, previous ?? null, owner.generation)
+  if (granted && action !== 'start') {
+    await finishStop()
+    return String(granted.id)
+  }
+  const id = granted
+    ? String(granted.id)
+    : `${runId}:${action}:${previous ?? 'initial'}:after:${owner.generation}`
+  db.db
+    .prepare(
+      'INSERT OR IGNORE INTO managed_intents(id, run_id, action, previous) VALUES (?, ?, ?, ?)'
+    )
+    .run(id, runId, action, previous ?? null)
+  const intent = db.db.prepare('SELECT generation FROM managed_intents WHERE id = ?').get(id)
+  if (intent?.generation != null && action !== 'start') {
+    await finishStop()
+    return id
+  }
+  const { generation } = await requestManagedOwner(String(owner.endpoint), {
+    id,
+    command: ['native', 'fence'],
+    options: {
+      token: String(owner.token),
+      assignment: String(owner.owner),
+      run: runId,
+      action,
+      previous: previous ?? ''
+    }
+  }).catch(() => {
+    throw new OrchestrationError(
+      'managed_admission_refused',
+      'Managed owner admission did not complete. No Dispatch was accepted; retry the same request after resolving the owner condition.'
+    )
+  })
+  db.db
+    .prepare('UPDATE managed_intents SET generation = ? WHERE id = ? AND generation IS NULL')
+    .run(generation, id)
+  db.db
+    .prepare(
+      'UPDATE managed_runs SET closed = 1, generation = ? WHERE run_id = ? AND dispatch_id IS ? AND generation <= ?'
+    )
+    .run(generation, runId, previous ?? null, generation)
+  if (action === 'start') {
+    const changed = db.db
+      .prepare(
+        'UPDATE managed_controls SET permit_id = ?, permit_sequence = ? WHERE run_id = ? AND sequence = ? AND stop_pending = 0'
+      )
+      .run(id, control.sequence, runId, control.sequence)
+    if (!changed.changes) {
+      throw new OrchestrationError(
+        'managed_admission_refused',
+        'Managed control changed during admission.'
+      )
+    }
+  } else {
+    await finishStop()
+  }
+  return id
+}
+
+export async function admitManagedProcess(
+  db: OrchestrationDb,
+  handle: string,
+  sessionId: string,
+  spawnToken: string
+): Promise<void> {
+  const historical = db.db
+    .prepare(
+      'SELECT id FROM dispatch_contexts WHERE assignee_handle = ? OR assignee_orca_session_id = ? OR id IN (SELECT dispatch_id FROM managed_processes WHERE session_id = ?) ORDER BY rowid DESC LIMIT 1'
+    )
+    .get(handle, sessionId, sessionId)
+  const dispatch = historical && db.getDispatchContextById(String(historical.id))
+  if (!dispatch) {
+    return
+  }
+  const owner = db.db.prepare('SELECT * FROM managed_runs WHERE run_id = ?').get(dispatch.run_id)
+  if (!owner) {
+    return
+  }
+  if (!['pending', 'dispatched'].includes(dispatch.status)) {
+    if (owner.dispatch_id === dispatch.id && !owner.closed) {
+      await fenceManagedRun(db, dispatch.run_id, 'restart', dispatch.id)
+    }
+    throw new Error('managed_process_restart_requires_task_retry')
+  }
+  if (owner.closed || owner.dispatch_id !== dispatch.id) {
+    throw new Error('managed_process_generation_fenced')
+  }
+  const hash = createHash('sha256').update(`osa-worker-v1:${sessionId}:${spawnToken}`).digest('hex')
+  const previous = db.db
+    .prepare('SELECT * FROM managed_processes WHERE dispatch_id = ?')
+    .get(dispatch.id)
+  if (previous && (previous.session_id !== sessionId || previous.proof_hash !== hash)) {
+    await fenceManagedRun(db, dispatch.run_id, 'restart', dispatch.id)
+    throw new Error('managed_process_restart_requires_task_retry')
+  }
+  db.db
+    .prepare('INSERT OR IGNORE INTO managed_processes VALUES (?, ?, ?)')
+    .run(dispatch.id, sessionId, hash)
+}
+
+/** Called in the dispatch transaction; the trigger also refuses older binaries and other start entry points. */
+export function consumeManagedStart(
+  db: Database.Database,
+  runId: string,
+  dispatchId: string,
+  intentId?: string
+): void {
+  const owner = db.prepare('SELECT * FROM managed_runs WHERE run_id = ?').get(runId)
+  if (!owner) {
+    return
+  }
+  const intent = db.prepare('SELECT * FROM managed_intents WHERE id = ?').get(intentId ?? '')
+  const control = db.prepare('SELECT * FROM managed_controls WHERE run_id = ?').get(runId)
+  if (
+    !control ||
+    control.stop_pending ||
+    control.permit_id !== intentId ||
+    control.permit_sequence !== control.sequence
+  ) {
+    throw new Error('managed_start_requires_current_fence')
+  }
+  if (
+    !intent ||
+    intent.run_id !== runId ||
+    intent.action !== 'start' ||
+    intent.generation == null ||
+    intent.generation !== owner.generation ||
+    intent.consumed_by ||
+    intent.previous !== owner.dispatch_id
+  ) {
+    throw new Error('managed_start_requires_current_fence')
+  }
+  db.prepare('INSERT INTO managed_dispatches VALUES (?, ?, ?)').run(
+    dispatchId,
+    runId,
+    intent.generation
+  )
+  db.prepare('UPDATE managed_intents SET consumed_by = ? WHERE id = ?').run(dispatchId, intentId!)
+  db.prepare(
+    'UPDATE managed_runs SET generation = ?, dispatch_id = ?, closed = 0 WHERE run_id = ?'
+  ).run(intent.generation, dispatchId, runId)
+}
+
+export function assertManagedStop(db: Database.Database, runId: string, dispatchId: string): void {
+  const owner = db
+    .prepare('SELECT closed, dispatch_id FROM managed_runs WHERE run_id = ?')
+    .get(runId)
+  if (owner?.dispatch_id === dispatchId && !owner.closed) {
+    throw new Error('managed_stop_requires_fence')
+  }
+}
diff --git a/src/main/runtime/rpc/methods/orchestration/managed-methods.ts b/src/main/runtime/rpc/methods/orchestration/managed-methods.ts
new file mode 100644
index 00000000..961c37d8
--- /dev/null
+++ b/src/main/runtime/rpc/methods/orchestration/managed-methods.ts
@@ -0,0 +1,166 @@
+import { revokeManagedPermit } from '../../../orchestration/managed-delivery'
+import { createHash, timingSafeEqual } from 'node:crypto'
+import type { z } from 'zod'
+import { defineMethod } from '../../core'
+import {
+  ManagedRunParams,
+  WorkerAttestParams,
+  ReliabilityCapabilitiesParams
+} from '../../../../../shared/rpc-contract/orchestration-managed-params'
+import { registerManagedRun } from '../../../orchestration/managed-run'
+import type { OrcaRuntimeService } from '../../../orca-runtime'
+import { getStructuredAgentSessionHost } from '../../../../native-chat/agent-session-wire/structured-agent-session-registry'
+import { agentSessionLeaseAdmitsWriter } from '../../../../../shared/agent-session/lifecycle/agent-session-lease-adjudication'
+import { resolveStructuredWorkerIdentityForSession } from '../../../structured-worker-authority'
+
+export async function attestManagedWorker(
+  runtime: OrcaRuntimeService,
+  input: z.infer<typeof WorkerAttestParams>
+) {
+  const db = runtime.getOrchestrationDb()
+  let handle: string,
+    incarnation: string,
+    subject: string,
+    paneKey: string,
+    dispatchIncarnation: string
+  if (input.evidence.kind === 'session') {
+    await runtime.ensureStructuredAgentSessionHost()
+    const record = getStructuredAgentSessionHost()?.deps.store.requireWritableRecord(
+      input.evidence.sessionId
+    )
+    const token = record?.lease.ownerProcess?.spawnToken
+    if (!record || !token || !agentSessionLeaseAdmitsWriter(record.lease)) {
+      throw new Error('worker_identity_unavailable')
+    }
+    const expected = createHash('sha256')
+      .update(`osa-worker-v1:${input.evidence.sessionId}:${token}`)
+      .digest()
+    const supplied = Buffer.from(input.evidence.proof, 'hex')
+    if (supplied.length !== expected.length || !timingSafeEqual(supplied, expected)) {
+      throw new Error('worker_identity_refused')
+    }
+    const identity = resolveStructuredWorkerIdentityForSession(input.evidence.sessionId, db)
+    if (!identity || identity.hostScope.kind !== 'local') {
+      throw new Error('worker_identity_unavailable')
+    }
+    if (identity.sessionId !== input.evidence.sessionId) {
+      throw new Error('managed_worker_clear_requires_new_dispatch')
+    }
+    handle = identity.handle
+    paneKey = identity.paneKey
+    dispatchIncarnation = identity.processIncarnation
+    incarnation = `${input.evidence.sessionId}:${record.lease.runtimeFence}:${createHash('sha256').update(token).digest('hex')}`
+    subject = input.evidence.sessionId
+  } else {
+    const authority = runtime.verifyOrchestrationCompatibilityCaller(input.evidence)
+    if (!authority || authority.hostScope.kind !== 'local') {
+      throw new Error('worker_identity_refused')
+    }
+    handle = authority.terminalHandle
+    incarnation = authority.processIncarnation
+    subject = authority.paneKey
+    paneKey = authority.paneKey
+    dispatchIncarnation = authority.processIncarnation
+  }
+  let dispatch = db.getActiveDispatchForTerminal(handle)
+  if (!dispatch) {
+    throw new Error('worker_dispatch_inactive')
+  }
+  if (
+    !db.isDispatchProcessCurrent({
+      dispatchId: dispatch.id,
+      paneKey,
+      processIncarnation: dispatchIncarnation
+    })
+  ) {
+    throw new Error('worker_dispatch_process_mismatch')
+  }
+  if (
+    input.evidence.kind === 'session' &&
+    db.db.prepare('SELECT 1 FROM managed_runs WHERE run_id = ?').get(dispatch.run_id)
+  ) {
+    const process = db.db
+      .prepare('SELECT * FROM managed_processes WHERE dispatch_id = ?')
+      .get(dispatch.id)
+    if (
+      !process ||
+      process.session_id !== input.evidence.sessionId ||
+      process.proof_hash !== input.evidence.proof
+    ) {
+      throw new Error('worker_dispatch_spawn_mismatch')
+    }
+  }
+  if (
+    input.purpose === 'review-snapshot' &&
+    dispatch.creator_dispatch_id &&
+    !db.db
+      .prepare('SELECT 1 FROM managed_runs WHERE run_id = ? AND owner = ?')
+      .get(dispatch.run_id, input.audience)
+  ) {
+    dispatch = db.getDispatchContextById(dispatch.creator_dispatch_id)
+    if (!dispatch) {
+      throw new Error('review_parent_unavailable')
+    }
+  }
+  const managed = db.db
+    .prepare('SELECT owner, generation, dispatch_id, closed FROM managed_runs WHERE run_id = ?')
+    .get(dispatch.run_id)
+  if (
+    !managed ||
+    managed.closed ||
+    managed.dispatch_id !== dispatch.id ||
+    managed.owner !== input.audience
+  ) {
+    throw new Error('worker_generation_fenced')
+  }
+  return {
+    assignmentId: managed.owner,
+    generation: managed.generation,
+    dispatchId: dispatch.id,
+    taskId: dispatch.task_id,
+    runId: dispatch.run_id,
+    subject,
+    incarnation,
+    runtimeId: runtime.getRuntimeId(),
+    host: 'local',
+    audience: input.audience,
+    purpose: input.purpose ?? 'worker',
+    expiresAt: Date.now() + 30000
+  }
+}
+
+export const ORCHESTRATION_MANAGED_METHODS = [
+  defineMethod({
+    name: 'orchestration.reliabilityCapabilities',
+    permission: 'workspace',
+    params: ReliabilityCapabilitiesParams,
+    handler: () => ({
+      protocol: 1,
+      inputStream: 1,
+      managedExecution: 1,
+      authenticatedReports: 1,
+      deliveryFence: 1,
+      executionHosts: ['local']
+    })
+  }),
+  defineMethod({
+    name: 'orchestration.managedRun',
+    permission: 'workspace',
+    params: ManagedRunParams,
+    handler: (params, { runtime }) => {
+      const db = runtime.getOrchestrationDb()
+      if (params.action !== 'revoke') {
+        return registerManagedRun(db, { ...params, action: params.action })
+      }
+      registerManagedRun(db, { ...params, action: 'status' })
+      revokeManagedPermit(db, params.runId, false)
+      return registerManagedRun(db, { ...params, action: 'status' })
+    }
+  }),
+  defineMethod({
+    name: 'orchestration.attestWorker',
+    permission: 'workspace',
+    params: WorkerAttestParams,
+    handler: (params, { runtime }) => attestManagedWorker(runtime, params)
+  })
+]
diff --git a/src/main/runtime/rpc/methods/orchestration/managed-report-methods.ts b/src/main/runtime/rpc/methods/orchestration/managed-report-methods.ts
new file mode 100644
index 00000000..4295ae22
--- /dev/null
+++ b/src/main/runtime/rpc/methods/orchestration/managed-report-methods.ts
@@ -0,0 +1,183 @@
+import { createHash } from 'node:crypto'
+import { defineMethod } from '../../core'
+import {
+  WorkerReportParams,
+  ManagedReportsParams,
+  WorkerReportReceiptParams
+} from '../../../../../shared/rpc-contract/orchestration-managed-params'
+import { attestManagedWorker } from './managed-methods'
+
+export const ORCHESTRATION_MANAGED_REPORT_METHODS = [
+  defineMethod({
+    name: 'orchestration.workerReportReceipt',
+    permission: 'workspace',
+    params: WorkerReportReceiptParams,
+    handler: (params, { runtime }) => {
+      const row = runtime
+        .getOrchestrationDb()
+        .db.prepare('SELECT * FROM managed_reports WHERE id = ?')
+        .get(params.reportId)
+      const credential = createHash('sha256').update(JSON.stringify(params.evidence)).digest('hex')
+      if (!row || row.credential_hash !== credential) {
+        throw new Error('worker_report_receipt_denied')
+      }
+      const proof = JSON.parse(String(row.proof_json))
+      if (proof.assignmentId !== params.audience) {
+        throw new Error('worker_report_receipt_denied')
+      }
+      return {
+        reportId: params.reportId,
+        messageId: row.message_id,
+        state: row.message_id ? 'queued' : 'reserved',
+        proof
+      }
+    }
+  }),
+  defineMethod({
+    name: 'orchestration.workerReport',
+    permission: 'workspace',
+    params: WorkerReportParams,
+    handler: async (params, { runtime }) => {
+      if (params.purpose && params.purpose !== 'worker') {
+        throw new Error('worker_report_requires_worker_authority')
+      }
+      const db = runtime.getOrchestrationDb()
+      const request = {
+        command: params.request.command,
+        options: Object.fromEntries(
+          Object.entries(params.request.options).sort(([a], [b]) => a.localeCompare(b))
+        )
+      }
+      const body = JSON.stringify(request)
+      if (Buffer.byteLength(body) > 500000) {
+        throw new Error('worker_report_too_large')
+      }
+      const hash = createHash('sha256').update(body).digest('hex')
+      const credential = createHash('sha256').update(JSON.stringify(params.evidence)).digest('hex')
+      const previous = db.db
+        .prepare('SELECT * FROM managed_reports WHERE id = ?')
+        .get(params.reportId)
+      if (previous && (previous.hash !== hash || previous.credential_hash !== credential)) {
+        throw new Error('worker_report_id_conflict')
+      }
+      if (previous?.message_id) {
+        return {
+          reportId: params.reportId,
+          sequence: previous.sequence,
+          messageId: previous.message_id,
+          state: 'queued'
+        }
+      }
+      const proof = await attestManagedWorker(runtime, params)
+      if (request.options.assignment !== proof.assignmentId) {
+        throw new Error('worker_report_assignment_mismatch')
+      }
+      const result = db.commitWorkerDoneMessageMutation(() => {
+        const current = db.db
+          .prepare('SELECT * FROM managed_runs WHERE run_id = ?')
+          .get(proof.runId)
+        if (
+          !current ||
+          current.closed ||
+          current.dispatch_id !== proof.dispatchId ||
+          current.generation !== proof.generation
+        ) {
+          throw new Error('worker_generation_fenced')
+        }
+        let report = db.db
+          .prepare('SELECT * FROM managed_reports WHERE id = ?')
+          .get(params.reportId)
+        if (!report) {
+          if (
+            db.db
+              .prepare('SELECT 1 FROM managed_reports WHERE dispatch_id = ? AND message_id IS NULL')
+              .get(proof.dispatchId)
+          ) {
+            throw new Error('worker_report_prior_reservation_unresolved')
+          }
+          const sequence =
+            Number(
+              db.db
+                .prepare(
+                  'SELECT COALESCE(MAX(sequence), 0) AS n FROM managed_reports WHERE dispatch_id = ?'
+                )
+                .get(proof.dispatchId)?.n
+            ) + 1
+          db.db
+            .prepare(
+              'INSERT INTO managed_reports(id, dispatch_id, run_id, sequence, hash, credential_hash, request_json, proof_json) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+            )
+            .run(
+              params.reportId,
+              proof.dispatchId,
+              proof.runId,
+              sequence,
+              hash,
+              credential,
+              body,
+              JSON.stringify(proof)
+            )
+          report = db.db.prepare('SELECT * FROM managed_reports WHERE id = ?').get(params.reportId)
+        }
+        if (!report || report.hash !== hash || report.credential_hash !== credential) {
+          throw new Error('worker_report_id_conflict')
+        }
+        let messageId = report.message_id
+        if (params.action === 'enqueue' && !messageId) {
+          messageId = db.insertMessage({
+            from: `dispatch:${proof.dispatchId}`,
+            to: `run:${proof.runId}`,
+            runId: proof.runId,
+            subject: 'OSA domain report',
+            type: 'status',
+            payload: JSON.stringify({ protocol: 'osa-report-v1', reportId: params.reportId })
+          }).id
+          db.db
+            .prepare('UPDATE managed_reports SET message_id = ? WHERE id = ?')
+            .run(messageId, params.reportId)
+        }
+        return {
+          reportId: params.reportId,
+          sequence: report.sequence,
+          messageId,
+          state: messageId ? 'queued' : 'reserved'
+        }
+      })
+      if (result.messageId) {
+        runtime.notifyMessageArrived(`run:${proof.runId}`, 'status')
+      }
+      return result
+    }
+  }),
+  defineMethod({
+    name: 'orchestration.managedReports',
+    permission: 'workspace',
+    params: ManagedReportsParams,
+    handler: (params, { runtime }) => {
+      const db = runtime.getOrchestrationDb().db
+      const owner = db
+        .prepare('SELECT owner, token FROM managed_runs WHERE run_id = ?')
+        .get(params.runId)
+      if (!owner || owner.owner !== params.owner || owner.token !== params.token) {
+        throw new Error('managed_owner_mismatch')
+      }
+      return {
+        reports: params.messageIds.map((id) => {
+          const row = db
+            .prepare('SELECT * FROM managed_reports WHERE message_id = ? AND run_id = ?')
+            .get(id, params.runId)
+          return row
+            ? {
+                messageId: id,
+                reportId: row.id,
+                sequence: row.sequence,
+                hash: row.hash,
+                request: JSON.parse(String(row.request_json)),
+                proof: JSON.parse(String(row.proof_json))
+              }
+            : { messageId: id, refusal: 'not-an-authenticated-report' }
+        })
+      }
+    }
+  })
+]
diff --git a/src/main/runtime/rpc/methods/orchestration/worker/worker-stop-flight.ts b/src/main/runtime/rpc/methods/orchestration/worker/worker-stop-flight.ts
new file mode 100644
index 00000000..5eaa0df4
--- /dev/null
+++ b/src/main/runtime/rpc/methods/orchestration/worker/worker-stop-flight.ts
@@ -0,0 +1,46 @@
+import type { OrcaRuntimeService } from '../../../../orca-runtime'
+import { fenceManagedRun } from '../../../../orchestration/managed-run'
+
+const activeStopByRuntime = new WeakMap<OrcaRuntimeService, Map<string, Promise<unknown>>>()
+
+/** Coalesce same-runtime stops so only one closes; beginWorkerStop admits this epoch only to recover a row stranded by a dead runtime. */
+export function dedupeWorkerStop(
+  runtime: OrcaRuntimeService,
+  dispatchId: string,
+  stop: () => Promise<unknown>
+): Promise<unknown> {
+  let active = activeStopByRuntime.get(runtime)
+  if (!active) {
+    active = new Map()
+    activeStopByRuntime.set(runtime, active)
+  }
+  const inFlight = active.get(dispatchId)
+  if (inFlight) {
+    return inFlight
+  }
+  const started: Promise<unknown> = Promise.resolve()
+    .then(async () => {
+      const db = runtime.getOrchestrationDb(),
+        context = db.getDispatchContextById(dispatchId)
+      // Local closure fences synchronously; owner outage must not keep the old process running.
+      const fence = context
+        ? fenceManagedRun(db, context.run_id, 'stop', dispatchId).catch((error) => {
+            if (
+              !db.db.prepare('SELECT closed FROM managed_runs WHERE run_id = ?').get(context.run_id)
+                ?.closed
+            ) {
+              throw error
+            }
+          })
+        : Promise.resolve()
+      const [result] = await Promise.all([stop(), fence])
+      return result
+    })
+    .finally(() => {
+      if (active.get(dispatchId) === started) {
+        active.delete(dispatchId)
+      }
+    })
+  active.set(dispatchId, started)
+  return started
+}
