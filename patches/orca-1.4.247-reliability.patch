+import { z } from 'zod'
+
+export const InputStreamRequest = z
+  .object({
+    sessionId: z.string().min(1),
+    consumer: z.string().min(32).max(256),
+    action: z.enum(['register', 'read', 'ack', 'barrier']),
+    streamId: z.string().optional(),
+    cursor: z.number().int().nonnegative().safe().optional()
+  })
+  .strict()
diff --git a/src/shared/rpc-contract/orchestration-managed-params.ts b/src/shared/rpc-contract/orchestration-managed-params.ts
new file mode 100644
index 00000000..78e88df7
--- /dev/null
+++ b/src/shared/rpc-contract/orchestration-managed-params.ts
@@ -0,0 +1,69 @@
+import { z } from 'zod'
+
+export const ReliabilityCapabilitiesParams = z.object({}).strict()
+
+export const ManagedRunParams = z
+  .object({
+    runId: z.string().min(1),
+    owner: z.string().min(1),
+    token: z.string().min(32),
+    endpoint: z.string().min(1),
+    action: z.enum(['register', 'status', 'adopt', 'revoke']),
+    dispatchId: z.string().min(1).optional()
+  })
+  .strict()
+export const WorkerAttestParams = z
+  .object({
+    evidence: z.discriminatedUnion('kind', [
+      z
+        .object({
+          kind: z.literal('session'),
+          sessionId: z.string().min(1),
+          proof: z.string().length(64)
+        })
+        .strict(),
+      z
+        .object({
+          kind: z.literal('terminal'),
+          terminalHandle: z.string().min(1),
+          paneKey: z.string().min(1),
+          launchToken: z.string().min(1)
+        })
+        .strict()
+    ]),
+    audience: z.string().min(1),
+    purpose: z.enum(['worker', 'review-snapshot']).optional()
+  })
+  .strict()
+
+export const WorkerReportParams = WorkerAttestParams.extend({
+  action: z.literal('enqueue'),
+  reportId: z.string().min(1).max(256),
+  request: z
+    .object({
+      command: z.tuple([
+        z.literal('report'),
+        z.enum(['ready', 'blocked', 'dropped', 'failed', 'progress', 'waiting'])
+      ]),
+      options: z
+        .object({
+          ticket: z.string().trim().min(1),
+          assignment: z.string().min(1),
+          token: z.string().min(1),
+          summary: z.string().trim().min(1)
+        })
+        .catchall(z.string())
+    })
+    .strict()
+}).strict()
+export const ManagedReportsParams = z
+  .object({
+    runId: z.string().min(1),
+    owner: z.string().min(1),
+    token: z.string().min(32),
+    messageIds: z.array(z.string()).max(1000)
+  })
+  .strict()
+export const WorkerReportReceiptParams = WorkerAttestParams.extend({
+  reportId: z.string().min(1).max(256)
+}).strict()
