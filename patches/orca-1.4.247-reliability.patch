@@ -0,0 +1,195 @@
+import './unused-default-rpc-methods.test-fixture'
+import { createHash } from 'node:crypto'
+import { afterEach, expect, test, vi } from 'vitest'
+import {
+  createSessionCallerHarness,
+  orchestrationRequest,
+  resultOf,
+  SESSION_X,
+  WORKSPACE_X,
+  type SessionCallerHarness
+} from './orchestration-session-caller-test-fixture'
+import {
+  mintStructuredWorkerHandle,
+  mintStructuredWorkerPaneKey,
+  structuredWorkerIdentities,
+  structuredWorkerProcessIncarnation
+} from '../structured-worker-identity'
+import { registerManagedRun, admitManagedProcess } from '../orchestration/managed-run'
+
+const hostRef = vi.hoisted((): { current: unknown } => ({ current: null }))
+vi.mock('../../native-chat/agent-session-wire/structured-agent-session-registry', () => ({
+  getStructuredAgentSessionHost: () => hostRef.current
+}))
+let h: SessionCallerHarness
+afterEach(() => {
+  h?.close()
+  vi.restoreAllMocks()
+})
+async function fixture() {
+  h = createSessionCallerHarness(hostRef)
+  const run = h.db.createRun({
+    objective: 'managed report',
+    coordinatorHandle: null,
+    coordinatorPaneKey: null
+  })
+  const owner = {
+    runId: run.id,
+    owner: 'assignment',
+    token: 's'.repeat(32),
+    endpoint: '/tmp/unused-owner.sock',
+    action: 'register' as const
+  }
+  registerManagedRun(h.db, owner)
+  // Seed only the owner grant; Dispatch creation, process pin, RPC authentication and report transaction are real.
+  h.db.db
+    .prepare(
+      "INSERT INTO managed_intents(id, run_id, action, generation) VALUES ('grant', ?, 'start', 1)"
+    )
+    .run(run.id)
+  h.db.db.prepare('UPDATE managed_runs SET generation = 1 WHERE run_id = ?').run(run.id)
+  h.db.db
+    .prepare(
+      "INSERT INTO managed_controls(run_id, sequence, permit_id, permit_sequence) VALUES (?, 0, 'grant', 0)"
+    )
+    .run(run.id)
+  const task = h.db.createTask({ runId: run.id, spec: 'report' })
+  const dispatch = h.db.createStartingWorkerDispatch({
+    creator: { kind: 'system' },
+    maxDepth: 10,
+    taskId: task.id,
+    startOptions: {},
+    managedIntent: 'grant'
+  }).dispatch
+  const handle = mintStructuredWorkerHandle(),
+    paneKey = mintStructuredWorkerPaneKey(SESSION_X),
+    processIncarnation = structuredWorkerProcessIncarnation(SESSION_X)
+  structuredWorkerIdentities.register({
+    handle,
+    sessionId: SESSION_X,
+    agent: 'claude',
+    paneKey,
+    processIncarnation,
+    worktreeId: WORKSPACE_X,
+    hostScope: { kind: 'local', hostId: 'local' }
+  })
+  h.db.prepareStartingWorkerAuthority({
+    dispatchId: dispatch.id,
+    handle,
+    paneKey,
+    processIncarnation,
+    worktreeId: WORKSPACE_X,
+    effects: [],
+    setupState: 'not_applicable'
+  })
+  await admitManagedProcess(h.db, handle, SESSION_X, 'spawn-owner')
+  const evidence = {
+    kind: 'session',
+    sessionId: SESSION_X,
+    proof: createHash('sha256').update(`osa-worker-v1:${SESSION_X}:spawn-owner`).digest('hex')
+  }
+  const request = {
+    command: ['report', 'progress'],
+    options: {
+      ticket: 'ticket',
+      assignment: owner.owner,
+      token: 'capability',
+      summary: 'step complete'
+    }
+  }
+  const enqueue = (id: string) =>
+    h.dispatch(
+      orchestrationRequest('orchestration.workerReport', {
+        action: 'enqueue',
+        reportId: id,
+        audience: owner.owner,
+        evidence,
+        request
+      })
+    )
+  return { run, owner, dispatch, evidence, request, enqueue }
+}
+
+test('RPC report commits one authenticated mailbox item, replays safely, and old proof only reads its receipt', async () => {
+  const f = await fixture()
+  const first = resultOf(await f.enqueue('report-1'))
+  expect(first).toMatchObject({ reportId: 'report-1', state: 'queued', sequence: 1 })
+  expect(resultOf(await f.enqueue('report-1'))).toEqual(first)
+  expect(h.db.db.prepare('SELECT COUNT(*) AS n FROM managed_reports').get()).toMatchObject({ n: 1 })
+  const batch = resultOf(
+    await h.dispatch(
+      orchestrationRequest('orchestration.managedReports', {
+        runId: f.run.id,
+        owner: f.owner.owner,
+        token: f.owner.token,
+        messageIds: [first.messageId, 'ordinary-mail']
+      })
+    )
+  )
+  expect(batch.reports).toEqual([
+    expect.objectContaining({
+      reportId: 'report-1',
+      proof: expect.objectContaining({ dispatchId: f.dispatch.id, generation: 1 })
+    }),
+    { messageId: 'ordinary-mail', refusal: 'not-an-authenticated-report' }
+  ])
+  h.db.db
+    .prepare('UPDATE managed_runs SET closed = 1, generation = 2 WHERE run_id = ?')
+    .run(f.run.id)
+  expect(await f.enqueue('report-2')).toMatchObject({ ok: false })
+  expect(resultOf(await f.enqueue('report-1'))).toEqual(first)
+  expect(
+    resultOf(
+      await h.dispatch(
+        orchestrationRequest('orchestration.workerReportReceipt', {
+          reportId: 'report-1',
+          audience: f.owner.owner,
+          evidence: f.evidence
+        })
+      )
+    )
+  ).toMatchObject({ state: 'queued' })
+  expect(
+    await h.dispatch(
+      orchestrationRequest('orchestration.workerReportReceipt', {
+        reportId: 'report-1',
+        audience: f.owner.owner,
+        evidence: { ...f.evidence, proof: '0'.repeat(64) }
+      })
+    )
+  ).toMatchObject({ ok: false })
+})
+
+test('RPC rejects changed process proof, immutable ID conflict and rolls back when mailbox insertion fails', async () => {
+  const f = await fixture()
+  expect(
+    await h.dispatch(
+      orchestrationRequest('orchestration.attestWorker', {
+        audience: f.owner.owner,
+        evidence: { ...f.evidence, proof: '0'.repeat(64) }
+      })
+    )
+  ).toMatchObject({ ok: false })
+  const insertion = vi.spyOn(h.db, 'insertMessage').mockImplementationOnce(() => {
+    throw new Error('injected mailbox failure')
+  })
+  expect(await f.enqueue('crash')).toMatchObject({ ok: false })
+  expect(h.db.db.prepare('SELECT COUNT(*) AS n FROM managed_reports').get()).toMatchObject({ n: 0 })
+  insertion.mockRestore()
+  expect(resultOf(await f.enqueue('crash'))).toMatchObject({ sequence: 1, state: 'queued' })
+  expect(
+    await h.dispatch(
+      orchestrationRequest('orchestration.workerReport', {
+        action: 'enqueue',
+        reportId: 'crash',
+        audience: f.owner.owner,
+        evidence: f.evidence,
+        request: { ...f.request, options: { ...f.request.options, summary: 'changed' } }
+      })
+    )
+  ).toMatchObject({ ok: false })
+  h.db.db
+    .prepare("UPDATE managed_processes SET proof_hash = 'different' WHERE dispatch_id = ?")
+    .run(f.dispatch.id)
+  expect(await f.enqueue('different-process')).toMatchObject({ ok: false })
+})
