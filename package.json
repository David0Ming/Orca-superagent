{
  "name": "orca-super-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "osa": "node --experimental-transform-types bin/osa.ts",
    "test": "vitest run --exclude '**/.osa/**' --exclude 'plugin/**'",
    "typecheck": "tsc --noEmit",
    "router:takeover": "node --experimental-transform-types bin/osa-router-takeover.ts",
    "osa:start": "node --input-type=module -e 'import {readFileSync} from \"node:fs\"; import {execFileSync} from \"node:child_process\"; const c=JSON.parse(readFileSync(\".osa/p4-live/supervisor-config.json\",\"utf8\")); execFileSync(process.execPath,[\"scripts/osa-service.mjs\",\"start\",\"--state\",c.state,...c.serveArgs],{stdio:\"inherit\"});'",
    "osa:stop": "node scripts/osa-service.mjs stop --state .osa/p4-live",
    "osa:status": "node scripts/osa-service.mjs status --state .osa/p4-live"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
