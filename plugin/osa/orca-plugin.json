{
  "manifestVersion": 2,
  "id": "osa",
  "name": "OSA",
  "version": "0.1.0",
  "description": "Project tasks and conversations from the local OSA service.",
  "engines": { "orca": ">=1.4.247" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [{ "id": "osa", "title": "OSA", "icon": "layers", "entry": "src/panel.tsx", "ui": "components" }],
    "settings": [{ "key": "stateDir", "title": "OSA 状态目录", "description": "运行中 OSA 服务的绝对状态目录。", "type": "string", "default": "" }]
  },
  "capabilities": [{ "kind": "settings:own" }, { "kind": "storage:own" }]
}
